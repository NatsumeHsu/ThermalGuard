<Window x:Class="ThermalGuard.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:settings="clr-namespace:ThermalGuard.Views.Settings"
    Title="系統設定" Width="1120" Height="820" MinWidth="960" MinHeight="700"
    WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Background="Transparent" Foreground="{StaticResource TextBrush}">
  <materialDesign:Card Margin="14" UniformCornerRadius="20" Style="{StaticResource FloatingCardStyle}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <settings:SettingsHeader ImportRequested="ImportSettingsClick"
          ExportRequested="ExportSettingsClick" CloseRequested="CloseClick"
          MouseLeftButtonDown="TitleBarMouseLeftButtonDown"/>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <settings:SettingsNavigation x:Name="SettingsNavigation" SelectionChanged="SettingsMenuChanged"/>
        <Border Grid.Column="1" Background="{StaticResource MutedBrush}" Opacity="0.25"/>
        <settings:SettingsContentHost x:Name="SettingsContent" Grid.Column="2"/>
      </Grid>
    </Grid>
  </materialDesign:Card>
</Window>
