<Window x:Class="ThermalGuard.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:settings="clr-namespace:ThermalGuard.Views.Settings"
    Title="系統設定"
    Width="1120" Height="820" MinWidth="960" MinHeight="700"
    WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Background="Transparent" Foreground="{StaticResource TextBrush}">
  <materialDesign:Card Margin="14" UniformCornerRadius="20"
      Style="{StaticResource FloatingCardStyle}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="26,18" Background="Transparent" MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryContainerBrush}">
          <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"
              Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" Margin="12,0" FontSize="21" FontWeight="SemiBold"
            VerticalAlignment="Center" Text="系統設定"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Margin="0,0,8,0" Padding="14,7" Style="{StaticResource MaterialDesignOutlinedButton}"
              Content="匯入設定" Click="ImportSettingsClick"/>
          <Button Margin="0,0,8,0" Padding="14,7" Style="{StaticResource MaterialDesignOutlinedButton}"
              Content="匯出設定" Click="ExportSettingsClick"/>
          <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="關閉設定" Click="CloseClick">
            <materialDesign:PackIcon Kind="Close"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ListBox x:Name="SettingsMenu" Margin="14" SelectedIndex="0"
            SelectionChanged="SettingsMenuChanged" Background="Transparent" BorderThickness="0">
          <ListBoxItem Padding="14,12">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Cctv" Margin="0,0,12,0"/>
              <TextBlock VerticalAlignment="Center" Text="串流設定"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Padding="14,12">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Alert" Margin="0,0,12,0"/>
              <TextBlock VerticalAlignment="Center" Text="程式內部事件"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Padding="14,12">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="LanConnect" Margin="0,0,12,0"/>
              <TextBlock VerticalAlignment="Center" Text="Modbus 溫度"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Padding="14,12">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="RecordRec" Margin="0,0,12,0"/>
              <TextBlock VerticalAlignment="Center" Text="錄影設定"/>
            </StackPanel>
          </ListBoxItem>
        </ListBox>
        <Border Grid.Column="1" Background="{StaticResource MutedBrush}" Opacity="0.25"/>
        <Grid Grid.Column="2">
          <settings:StreamSettingsView x:Name="StreamSettingsPanel"/>
          <settings:RecordingSettingsView x:Name="RecordingSettingsPanel" Visibility="Collapsed"/>
          <settings:EventSettingsView x:Name="EventSettingsPanel" Visibility="Collapsed"/>
          <settings:ModbusSettingsView x:Name="ModbusSettingsPanel" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
  </materialDesign:Card>
</Window>
