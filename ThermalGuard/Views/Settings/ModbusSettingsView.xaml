<UserControl x:Class="ThermalGuard.Views.Settings.ModbusSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="UserControlLoaded">
  <Grid Margin="30,18,30,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Modbus 溫度讀取"/>
        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
            Text="設定熱像儀的 Modbus TCP 溫度輪詢"/>
      </StackPanel>
      <ComboBox x:Name="CameraSelector" Grid.Column="1" DisplayMemberPath="DisplayName"
          materialDesign:HintAssist.Hint="熱像儀"/>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <CheckBox FontSize="15" Content="啟用此熱像儀的 Modbus 溫度讀取"
          IsChecked="{Binding ElementName=CameraSelector, Path=SelectedItem.Enabled}"/>

      <materialDesign:Card Margin="0,20,0,0" Padding="24" UniformCornerRadius="12"
          Background="{StaticResource FloatingSurfaceBrush}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <materialDesign:PackIcon Kind="LanConnect" Width="22" Height="22"
                Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                VerticalAlignment="Center" Text="連線與讀取"/>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="22"/>
              <ColumnDefinition/><ColumnDefinition Width="22"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBox materialDesign:HintAssist.Hint="Modbus TCP Port"
                Text="{Binding ElementName=CameraSelector, Path=SelectedItem.Port}"/>
            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="輪詢間隔（毫秒）"
                Text="{Binding ElementName=CameraSelector, Path=SelectedItem.PollIntervalMs}"/>
            <ComboBox Grid.Column="4"
                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccessModes}"
                SelectedItem="{Binding ElementName=CameraSelector, Path=SelectedItem.AccessMode}"
                materialDesign:HintAssist.Hint="存取模式"/>
          </Grid>
                    </StackPanel>
      </materialDesign:Card>
      <materialDesign:Card Margin="0,18,0,0" Padding="24" UniformCornerRadius="12"
          Background="{StaticResource FloatingSurfaceBrush}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <materialDesign:PackIcon Kind="SelectionMultiple" Width="22" Height="22"
                Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                VerticalAlignment="Center" Text="啟用框溫"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ElementName=CameraSelector, Path=SelectedItem.Regions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="4,7" Content="{Binding Label}" IsChecked="{Binding Enabled}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="4,14,0,0" Foreground="{StaticResource MutedBrush}"
              Text="未勾選的框溫不參與最高溫與警報事件判定。"/>
        </StackPanel>
      </materialDesign:Card>
    </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Margin="0,18,4,4" MinWidth="190" Height="48" Padding="20,0"
        HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
        Style="{StaticResource MaterialDesignRaisedButton}" Content="儲存並套用 Modbus"
        Click="SaveClick"/>
  </Grid>
</UserControl>
