<UserControl x:Class="ThermalGuard.Views.Settings.SettingsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="26,18" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryContainerBrush}">
      <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Grid.Column="1" Margin="12,0" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Text="系統設定"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Margin="0,0,8,0" Padding="14,7" Style="{StaticResource MaterialDesignOutlinedButton}" Content="匯入設定" Click="ImportClick"/>
      <Button Margin="0,0,8,0" Padding="14,7" Style="{StaticResource MaterialDesignOutlinedButton}" Content="匯出設定" Click="ExportClick"/>
      <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="關閉設定" Click="CloseClick"><materialDesign:PackIcon Kind="Close"/></Button>
    </StackPanel>
  </Grid>
</UserControl>
