<UserControl x:Class="ThermalGuard.Views.Settings.EventSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="UserControlLoaded">
  <Grid Margin="30,18,30,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/>
        <ColumnDefinition Width="180"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="逐框警報設定"/>
        <TextBlock Margin="0,5,18,0" Foreground="{StaticResource MutedBrush}"
            Text="每個框溫的五種警報都有獨立觸發條件與事件動作"/>
      </StackPanel>
      <ComboBox x:Name="CameraSelector" Grid.Column="1" DisplayMemberPath="DisplayName"
          SelectionChanged="SelectionChanged" materialDesign:HintAssist.Hint="攝影機"/>
      <ComboBox x:Name="RegionSelector" Grid.Column="3" SelectionChanged="SelectionChanged"
          materialDesign:HintAssist.Hint="框溫編號"/>
    </Grid>
    <DataGrid x:Name="AlarmGrid" Grid.Row="1" Margin="0,20,0,0" AutoGenerateColumns="False"
        CanUserAddRows="False" CanUserDeleteRows="False" FrozenColumnCount="2"
        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
        RowHeight="44" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="啟用" Binding="{Binding Enabled}" Width="58"/>
        <DataGridTextColumn Header="警報類型" Binding="{Binding EventType}" IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="觸發值 °C" Binding="{Binding TriggerValueDisplay}" Width="90"/>
        <DataGridTextColumn Header="confirm_cycle" Binding="{Binding ConfirmCyclesDisplay}" Width="98"/>
        <DataGridTextColumn Header="deadband °C" Binding="{Binding DeadbandDisplay}" Width="96"/>
        <DataGridTextColumn Header="溫升觀察秒數" Binding="{Binding RiseWindowDisplay}" Width="108"/>
        <DataGridCheckBoxColumn Header="彈窗" Binding="{Binding ShowPopup}" Width="62"/>
        <DataGridCheckBoxColumn Header="聲音" Binding="{Binding PlayAlarmSound}" Width="62"/>
        <DataGridTemplateColumn Header="警報音" Width="105">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AlarmSounds}"
                  SelectedItem="{Binding AlarmSound, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="事件持續方式" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=RetentionModes}"
                  SelectedItem="{Binding RetentionMode, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="固定秒數" Binding="{Binding DurationSeconds}" Width="88"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button Grid.Row="2" Margin="0,18,4,4" MinWidth="190" Height="48" Padding="20,0"
        HorizontalAlignment="Right" Style="{StaticResource MaterialDesignRaisedButton}"
        Content="儲存逐框警報設定" Click="SaveEventsClick"/>
  </Grid>
</UserControl>
