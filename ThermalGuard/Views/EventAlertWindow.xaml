<Window x:Class="ThermalGuard.Views.EventAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="390" Height="200" WindowStyle="None" AllowsTransparency="True"
    ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
    WindowStartupLocation="Manual" Background="Transparent">
  <materialDesign:Card Margin="10" Padding="20" UniformCornerRadius="14"
      Background="{StaticResource FloatingSurfaceBrush}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" CornerRadius="22" Background="#33FF5252" VerticalAlignment="Top">
        <materialDesign:PackIcon Kind="Alert" Width="26" Height="26" Foreground="#FF5252"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,8,0">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="事件警報"/>
        <TextBlock x:Name="CameraText" Margin="0,8,0,0" FontSize="14"/>
        <TextBlock x:Name="EventText" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#FF5252"/>
        <TextBlock x:Name="TemperatureText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="RegionText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <Button Grid.Column="2" Padding="14,7" VerticalAlignment="Bottom"
          Style="{StaticResource MaterialDesignRaisedButton}" Content="確認" Click="ConfirmClick">
      </Button>
    </Grid>
  </materialDesign:Card>
</Window>
